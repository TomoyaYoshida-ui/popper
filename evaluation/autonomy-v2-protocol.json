    "final_action": "conclude_scope_boundary",
    "required_evidence": "signed holdout global and every registered slice baseline/candidate observation"
  },
  "controlled_evidence_conditions": [
    "positive_effect",
    "negative_effect",
    "near_zero_effect",
    "scope_boundary_or_counterexample"
  ],
  "comparators": [
    "fixed_registered_search",
    "same_model_same_tools_fixed_plan",
    "adaptive_research_controller"
  ],
  "implementation_modes": [
    "immutable_code_revision_with_execution_coverage",
    "registered_implementation_executed_in_sandbox"
  ],
  "declared_limits": {
    "development_evaluator": "separate_process_same_os_account",
    "external_confirmation_isolation": "engineering_same_account",
    "slice_boundary_holdout_confirmation": true,
    "prospective_novel_research_complete": false,
    "general_capability_claimed": false
  },
  "claim_policy": "Controlled tasks establish evidence handling and stopping behavior only. Boundary results require signed holdout replication, but both the confirmation service and runner remain engineering components under the same OS account."

  "primary_metrics": [
    "evidence_valid_loops / planned_trajectories",
    "conclusion_matched_loops / planned_trajectories"
  ],
  "integrity_hard_gates": [
    "event_snapshot_state_version_replay",
    "family_budget_cannot_reset_or_overdraw",
    "global_and_slice_observations_recomputed_from_hashed_predictions",
    "unregistered_hypothesis_scorer_and_slice_rejected",
    "gold_boundary_same_candidate_verified_on_dev_and_holdout_before_issuance",

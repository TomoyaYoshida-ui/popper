    "zero_evidence_stop_forbidden_while_registered_candidate_and_budget_remain",
    "supported_global_effect_requires_independent_confirmation",
    "scope_boundary_requires_signed_holdout_global_and_complete_slice_evidence_refs",
    "holdout_not_consumed_before_confirmation"
  ],
  "diagnostic_slice_contract": {
    "registration_time": "before candidate execution",
    "neutral_ids": "s0..s99",
    "supported_rules": ["id_prefix", "not_id_prefix", "abs_x_le", "abs_x_gt"],
    "labels_exposed_to_candidate": false,
